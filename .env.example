# ----------------------------------------------------------------------------
# RMT (Risky Money Time) settings
#
# 1. Make a copy of this file named exactly:  .env
# 2. Paste your keys after the = signs (no quotes, no spaces).
#
# Everything works without keys except the AI chat. The real .env file is
# listed in .gitignore and never gets uploaded.
# ----------------------------------------------------------------------------

# Needed for the "Ask RMT" AI chat (https://console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# Optional: odds from many sportsbooks side by side (free key, 500 requests a
# month: https://the-odds-api.com). Without it you get one book's line per game.
ODDS_API_KEY=

# Optional: YouTube search by ticker or topic (Google Cloud → YouTube Data API v3).
# Without it you still get the latest videos from popular finance channels.
YOUTUBE_API_KEY=

# Optional: the Claude model the chat uses.
RMT_MODEL=claude-opus-5-5

# Set to 1 to always show sample data (handy with no internet).
RMT_DEMO=0
